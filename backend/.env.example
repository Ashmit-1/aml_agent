# ────────────────────────────────────────────────────────────────────────────
# LLM Agent Configuration
# ────────────────────────────────────────────────────────────────────────────
# The LangGraph agent reads these at runtime.  To switch providers just
# uncomment the block you need and fill in your API key.

# ── Option 1: Google Gemini ────────────────────────────────────────────────
# LLM_PROVIDER=google
# LLM_MODEL=gemini-2.0-flash
# LLM_API_KEY=your-google-api-key

# ── Option 2: OpenAI or OpenAI-compatible endpoint (Gemma, local LLM, etc.) ─
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=your-api-key
# LLM_BASE_URL=https://api.openai.com/v1       # default for OpenAI
# LLM_BASE_URL=https://your-endpoint.example/v1 # custom / local endpoint

# ── Generic ────────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO
